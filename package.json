{
  "name": "wows-launcher",
  "version": "0.1.0",
  "description": "战舰世界第三方启动器（增强外壳）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.wowslauncher.app",
    "productName": "WoWS Launcher",
    "electronDist": "node_modules/electron/dist",
    "publish": {
      "provider": "generic",
      "url": "https://example.com/wows-launcher/updates"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "scripts/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "build/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "certificateFile": "build/wows-launcher.pfx",
        "certificatePassword": "wowslauncher",
        "publisherName": "WoWS Launcher",
        "rfc3161TimeStampServer": null,
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WoWS Launcher"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
